# ==============================================================================
# CampusBridge AI — Frontend Environment Variables for Vercel
# ==============================================================================

# Backend API URL (Points to your FastAPI deployment, e.g. Render, Railway, Fly.io, or localhost)
NEXT_PUBLIC_API_URL=https://campusbridge-backend.onrender.com
NEXT_PUBLIC_API_BASE_URL=https://campusbridge-backend.onrender.com
CAMPUSBRIDGE_BACKEND_URL=https://campusbridge-backend.onrender.com

# LiveKit Voice Agent (WebRTC Cloud Gateway)
NEXT_PUBLIC_LIVEKIT_URL=wss://first-w4gv5xp4.livekit.cloud

# NextAuth Configuration
NEXTAUTH_URL=https://your-app.vercel.app
NEXTAUTH_SECRET=campusbridge-free-tier-secret-key-at-least-32-chars-long

# Neon Serverless PostgreSQL (Optional: Uses built-in institutional profiles if unset)
# DATABASE_URL=postgresql://user:password@ep-sample-pooler.us-east-2.aws.neon.tech/campusbridge?sslmode=require

