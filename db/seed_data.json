    "sql_practice_bank": [
        {
            "sql_id": "SQL-01",
            "title": "Top-3 Placed Cohorts by Department Using DENSE_RANK()",
            "concept": "Window Functions",
            "difficulty": "Medium",
            "schema_ddl": "CREATE TABLE placement_offers (offer_id INT, student_id VARCHAR, department VARCHAR, company VARCHAR, ctc_lpa DECIMAL(5,2));",
            "question_prompt": "Write a query to return the top 2 highest CTC offers per department using DENSE_RANK(). Output columns: department, student_id, company, ctc_lpa, rnk.",
            "expected_query": "WITH RankedOffers AS (SELECT department, student_id, company, ctc_lpa, DENSE_RANK() OVER (PARTITION BY department ORDER BY ctc_lpa DESC) as rnk FROM placement_offers) SELECT * FROM RankedOffers WHERE rnk <= 2;",
            "unlocks_skill": "SQL & Query Optimization",
            "alignment_boost_pct": 9
        },
        {
            "sql_id": "SQL-02",
            "title": "Identify Stale Skill Evidence Without Recent Micro-Defenses",
            "concept": "LEFT JOIN & Date Filtering",
            "difficulty": "Easy",
            "schema_ddl": "CREATE TABLE skill_evidence (evidence_id INT, student_id VARCHAR, skill_name VARCHAR, status VARCHAR); CREATE TABLE defense_attempts (attempt_id INT, evidence_id INT, score INT, attempted_at DATE);",
            "question_prompt": "Find all skill_evidence records currently in 'ARTIFACT_LINKED' status that have zero defense_attempts with a score >= 75.",
            "expected_query": "SELECT e.student_id, e.skill_name FROM skill_evidence e LEFT JOIN defense_attempts d ON e.evidence_id = d.evidence_id AND d.score >= 75 WHERE e.status = 'ARTIFACT_LINKED' AND d.attempt_id IS NULL;",
            "unlocks_skill": "Relational Data Modeling",
            "alignment_boost_pct": 7
        },
        {
            "sql_id": "SQL-03",
            "title": "Rolling 7-Day API P95 Latency Anomaly Detection",
            "concept": "CTEs & Moving Averages",
            "difficulty": "Hard",
            "schema_ddl": "CREATE TABLE mcp_telemetry (log_date DATE, tool_name VARCHAR, p95_ms INT);",
            "question_prompt": "Using a window frame of ROWS BETWEEN 6 PRECEDING AND CURRENT ROW, flag days where tool p95_ms exceeds 1.5x its 7-day rolling average.",
            "expected_query": "WITH RollingStats AS (SELECT log_date, tool_name, p95_ms, AVG(p95_ms) OVER (PARTITION BY tool_name ORDER BY log_date ROWS BETWEEN 6 PRECEDING AND CURRENT ROW) AS avg_7d FROM mcp_telemetry) SELECT * FROM RollingStats WHERE p95_ms > 1.5 * avg_7d;",
            "unlocks_skill": "Analytical SQL & Windowing",
            "alignment_boost_pct": 11
        }
